<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- The library's own packages come from those its gate packed from this commit, the
       siblings' from vendor/, every other package from nuget.org (06 PRT-ENG-001). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="packed" value="../artifacts/packages" />
    <add key="vendor" value="../vendor" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="packed">
      <package pattern="Portunus" />
      <package pattern="Portunus.*" />
    </packageSource>
    <packageSource key="vendor">
      <package pattern="Janus.*" />
      <package pattern="Hermes.Core" />
      <package pattern="Themis.Core" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
