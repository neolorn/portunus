<Project Sdk="Microsoft.NET.Sdk">

  <!-- Built only from the packages packed from the same commit, which change with every
       commit, so it has no lockfile and no locked restore (06 PRT-ENG-001). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Portunus.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbour\Harbour.csproj" />
  </ItemGroup>

</Project>
